# Production (DigitalOcean Droplet / managed Postgres):
# DEBUG=False
# DATABASE_URL=postgres://user:pass@host:25060/db?sslmode=require
# DB_SSLMODE=require
# ALLOWED_HOSTS=example.com,www.example.com,YOUR_DROPLET_IP,127.0.0.1,localhost,web
# CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# SECURE_SSL_REDIRECT=False
# SECURE_HSTS_SECONDS=31536000

# CATALOG_PER_PAGE=24

