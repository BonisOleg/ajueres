SECRET_KEY=change-me-in-production-use-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,web
# CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Local SQLite by default. For Docker Compose Postgres:
POSTGRES_DB=ajeres
POSTGRES_USER=ajeres
POSTGRES_PASSWORD=change-me-strong-password
DB_HOST=db
DB_PORT=5432
# DATABASE_URL=postgres://ajeres:change-me-strong-password@db:5432/ajeres
# DB_SSLMODE=disable

# Production (DigitalOcean Droplet / managed Postgres):
# DEBUG=False
# DATABASE_URL=postgres://user:pass@host:25060/db?sslmode=require
# DB_SSLMODE=require
# ALLOWED_HOSTS=example.com,www.example.com,YOUR_DROPLET_IP,127.0.0.1,localhost,web
# CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
# SECURE_SSL_REDIRECT=False
# SECURE_HSTS_SECONDS=31536000

# CATALOG_PER_PAGE=24

# Default admin (Vercel cold start / seed_site). Override in production if needed.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=admin
# DJANGO_SUPERUSER_EMAIL=admin@ajeres.uz
