SECRET_KEY=change-me-in-production-use-long-random-string
DEBUG=True
# Secret admin URL slug (no slashes). Do not use "admin".
ADMIN_URL=f7YG0XG1JUr0iUzF
ALLOWED_HOSTS=localhost,127.0.0.1,web
# PUBLIC_SITE_URL=https://ajeres.uz

# Local SQLite by default. For Docker Compose Postgres:
POSTGRES_DB=ajeres
POSTGRES_USER=ajeres
POSTGRES_PASSWORD=change-me-strong-password
DB_HOST=db
DB_PORT=5432
# DATABASE_URL=postgres://ajeres:change-me-strong-password@db:5432/ajeres
# DB_SSLMODE=disable

# Production VDS (Docker Compose on ahost / Droplet):
# DEBUG=False
# ALLOWED_HOSTS=ajeres.uz,www.ajeres.uz,YOUR_VDS_IP,127.0.0.1,localhost,web
# CSRF_TRUSTED_ORIGINS=https://ajeres.uz,https://www.ajeres.uz
# SECURE_SSL_REDIRECT=False
# SECURE_HSTS_SECONDS=31536000
# PUBLIC_SITE_URL=https://ajeres.uz
# Deploy: /var/www/ajeres && ./deploy.sh
# SSL: DEPLOY_SSL=1 ./deploy.sh (after certbot + docker.prod.conf paths)

# CATALOG_PER_PAGE=24

# Default admin is created only if missing. Re-seed does not reset the password.
